# ==========================================================
# BibSaaS Premium
# ENVIRONMENT TEMPLATE
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

NODE_ENV=development

PORT=5000

APP_NAME="BibSaaS"

APP_URL="http://localhost:5000"

CLIENT_URL="http://localhost:3000"

API_URL="http://localhost:5000/api"


# ==========================================================
# DATABASE - SUPABASE
# ==========================================================
DATABASE_URL="postgresql://postgres.eaxwgxonkgxbpsnfnyms:60smUOBioismqylo@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres.eaxwgxonkgxbpsnfnyms:60smUOBioismqyl@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"


# ==========================================================
# LOCAL DOCKER POSTGRES
# ==========================================================

POSTGRES_DB="bibsaas"

POSTGRES_USER="bibsaas"

POSTGRES_PASSWORD="Richebanani@030"


# ==========================================================
# JWT
# ==========================================================

JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

JWT_EXPIRES_IN="7d"

JWT_REFRESH_SECRET="CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET"

JWT_REFRESH_EXPIRES_IN="30d"

JWT_ISSUER="BibSaaS"

JWT_AUDIENCE="BibSaaS-Users"


# ==========================================================
# SUPER ADMIN
# ==========================================================

SUPER_ADMIN_EMAIL="admin@bibsaas.com"

SUPER_ADMIN_PASSWORD="Richebanani@030"

SUPER_ADMIN_NAME="BibSaaS Super Admin"

SUPER_ADMIN_ROLE="SUPER_ADMIN"


# ==========================================================
# SUPABASE
# ==========================================================

SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"

SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"


# ==========================================================
# SUPABASE STORAGE
# ==========================================================

SUPABASE_STORAGE_BUCKET_AVATARS="avatars"

SUPABASE_STORAGE_BUCKET_HAIRSTYLES="hairstyles"

SUPABASE_STORAGE_BUCKET_SALONS="salons"

SUPABASE_STORAGE_BUCKET_FACE_ANALYSIS="face-analysis"

SUPABASE_STORAGE_BUCKET_INVOICES="invoices"

SUPABASE_STORAGE_BUCKET_DOCUMENTS="documents"


# ==========================================================
# AI
# ==========================================================

AI_ENABLED=true

FACE_ANALYSIS_ENABLED=true

HAIRSTYLE_RECOMMENDATION_ENABLED=true

AI_RECOMMENDATION_ENABLED=true

OPENAI_API_KEY=""

AI_MODEL="gpt-5"

AI_MAX_TOKENS=4000

AI_TEMPERATURE=0.3

AI_TIMEOUT_MS=60000

AI_RETRY_ATTEMPTS=3

AI_MAX_REQUESTS_PER_MINUTE=30

AI_MAX_IMAGE_SIZE=10485760


# ==========================================================
# PAYMENT CORE
# ==========================================================

PAYMENT_ENABLED=true

PAYMENT_DEFAULT_PROVIDER="SIMULATED"

PAYMENT_CURRENCY="XAF"

DEFAULT_PAYMENT_CURRENCY="XAF"

PAYMENT_COUNTRY="CG"

MULTI_CURRENCY_ENABLED=true

SUPPORTED_CURRENCIES="XAF,EUR,USD,GBP,CAD"

ALLOW_CURRENCY_CONVERSION=true


# ==========================================================
# PAYMENT PROVIDERS
# ==========================================================

PAYMENT_PROVIDER_SIMULATED=true

PAYMENT_PROVIDER_MTN=true

PAYMENT_PROVIDER_AIRTEL=true

PAYMENT_PROVIDER_CARD=true


# ==========================================================
# SIMULATED PAYMENT
# ==========================================================

SIMULATED_PAYMENT_ENABLED=true

SIMULATED_PAYMENT_SUCCESS_RATE=100

SIMULATED_PAYMENT_DELAY_MS=1000

SIMULATED_PAYMENT_PROVIDER="SIMULATED"


# ==========================================================
# STRIPE - INTERNATIONAL CARDS
# ==========================================================

STRIPE_ENABLED=true

STRIPE_ENVIRONMENT="test"

STRIPE_SECRET_KEY=""

STRIPE_PUBLISHABLE_KEY=""

STRIPE_WEBHOOK_SECRET=""

STRIPE_API_VERSION=""

STRIPE_CURRENCY="XAF"

STRIPE_SUCCESS_URL="http://localhost:3000/payment/success"

STRIPE_CANCEL_URL="http://localhost:3000/payment/cancel"

STRIPE_WEBHOOK_URL="http://localhost:5000/api/payments/webhooks/stripe"


# ==========================================================
# CARD PAYMENT
# ==========================================================

CARD_PAYMENT_ENABLED=true

CARD_VISA_ENABLED=true

CARD_MASTERCARD_ENABLED=true

CARD_AMERICAN_EXPRESS_ENABLED=true

CARD_DISCOVER_ENABLED=true

CARD_3DS_ENABLED=true

CARD_SCA_ENABLED=true


# ==========================================================
# STRIPE SECURITY
# ==========================================================

STRIPE_REQUIRE_WEBHOOK_SIGNATURE=true

STRIPE_REQUIRE_IDEMPOTENCY=true

STRIPE_VERIFY_PAYMENT_AMOUNT=true

STRIPE_VERIFY_PAYMENT_CURRENCY=true

STRIPE_PAYMENT_TIMEOUT_MS=60000

# ==========================================================
# PAYMENT SECURITY
# ==========================================================

PAYMENT_REQUIRE_WEBHOOK_SIGNATURE=true

PAYMENT_REQUIRE_IDEMPOTENCY=true

PAYMENT_VERIFY_WEBHOOK=true

PAYMENT_VERIFY_AMOUNT=true

PAYMENT_VERIFY_CURRENCY=true

PAYMENT_TIMEOUT_MS=60000

PAYMENT_MAX_RETRIES=5

PAYMENT_RETRY_DELAY_MS=5000


# ==========================================================
# WEBHOOKS
# ==========================================================

WEBHOOK_ENABLED=true

WEBHOOK_TIMEOUT_MS=30000

WEBHOOK_MAX_RETRIES=5

WEBHOOK_RETRY_DELAY_MS=5000

WEBHOOK_LOG_PAYLOAD=false


# ==========================================================
# SUBSCRIPTIONS
# ==========================================================

SUBSCRIPTIONS_ENABLED=true

SUBSCRIPTION_AUTO_ACTIVATION=true

SUBSCRIPTION_AUTO_RENEWAL=false

SUBSCRIPTION_GRACE_PERIOD_DAYS=3

SUBSCRIPTION_EXPIRATION_CHECK_ENABLED=true


# ==========================================================
# INVOICES
# ==========================================================

INVOICES_ENABLED=true

INVOICE_AUTO_GENERATE=true

INVOICE_CURRENCY="XAF"

INVOICE_PREFIX="BIB"

INVOICE_COUNTRY="CG"


# ==========================================================
# SMTP
# ==========================================================

SMTP_ENABLED=true

SMTP_HOST="smtp.gmail.com"

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=""

SMTP_PASSWORD=""

SMTP_FROM="BibSaaS <noreply@bibsaas.com>"


# ==========================================================
# EMAIL NOTIFICATIONS
# ==========================================================

EMAIL_VERIFICATION_ENABLED=true

EMAIL_PASSWORD_RESET_ENABLED=true

EMAIL_PAYMENT_RECEIPT_ENABLED=true

EMAIL_SUBSCRIPTION_ENABLED=true

EMAIL_BOOKING_ENABLED=true

EMAIL_ADMIN_ALERTS_ENABLED=true


# ==========================================================
# FILE UPLOAD
# ==========================================================

MAX_FILE_SIZE=10485760

MAX_IMAGE_SIZE=10485760

ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

UPLOAD_DIRECTORY="uploads"


# ==========================================================
# SECURITY
# ==========================================================

BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_MAX_REQUESTS=10

PAYMENT_RATE_LIMIT_MAX_REQUESTS=20

WEBHOOK_RATE_LIMIT_MAX_REQUESTS=1000


# ==========================================================
# CORS
# ==========================================================

CORS_ORIGIN="http://localhost:3000"

CORS_CREDENTIALS=true


# ==========================================================
# COOKIES
# ==========================================================

COOKIE_SECURE=false

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE="lax"

SESSION_NAME="bibsaas_session"


# ==========================================================
# LOCALIZATION
# ==========================================================

DEFAULT_CURRENCY="XAF"

DEFAULT_COUNTRY="CG"

DEFAULT_LANGUAGE="fr"

DEFAULT_TIMEZONE="Africa/Brazzaville"

SUPPORTED_LANGUAGES="fr,en"


# ==========================================================
# BOOKING
# ==========================================================

BOOKING_ENABLED=true

BOOKING_PAYMENT_REQUIRED=true

BOOKING_CANCELLATION_ENABLED=true

BOOKING_MIN_ADVANCE_MINUTES=30


# ==========================================================
# NOTIFICATIONS
# ==========================================================

NOTIFICATIONS_ENABLED=true

NOTIFICATION_EMAIL_ENABLED=true

NOTIFICATION_PUSH_ENABLED=false

NOTIFICATION_SMS_ENABLED=false


# ==========================================================
# AUDIT LOG
# ==========================================================

AUDIT_LOG_ENABLED=true

AUDIT_LOG_PAYMENT_EVENTS=true

AUDIT_LOG_AUTH_EVENTS=true

AUDIT_LOG_ADMIN_EVENTS=true


# ==========================================================
# LOGGING
# ==========================================================

LOG_LEVEL="info"

LOG_FORMAT="combined"

LOG_PAYMENT_EVENTS=true

LOG_AI_EVENTS=true

LOG_WEBHOOK_EVENTS=true


# ==========================================================
# DEVELOPMENT
# ==========================================================

ENABLE_SWAGGER=true

ENABLE_PRISMA_STUDIO=true

ENABLE_DEBUG_LOGS=true

ENABLE_TEST_ENDPOINTS=true


# ==========================================================
# PRODUCTION SAFETY
# ==========================================================

DISABLE_SIMULATED_PAYMENTS_IN_PRODUCTION=true

DISABLE_DEBUG_IN_PRODUCTION=true

REQUIRE_HTTPS_IN_PRODUCTION=true

REQUIRE_STRONG_JWT_SECRET=true

REQUIRE_PAYMENT_WEBHOOK_SIGNATURE=true


# ==========================================================
# REDIS
# ==========================================================

REDIS_ENABLED=true

REDIS_URL="redis://localhost:6379"

REDIS_HOST="localhost"

REDIS_PORT=6379

REDIS_PASSWORD=""


# ==========================================================
# DOCKER
# ==========================================================

DOCKER_POSTGRES_HOST="postgres"

DOCKER_POSTGRES_PORT="5434"

DOCKER_REDIS_HOST="redis"

DOCKER_REDIS_PORT="6379"


