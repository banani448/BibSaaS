generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  phone              String?                  @unique
  password           String
  role               UserRole                 @default(CLIENT)
  status             AccountStatus            @default(PENDING)
  emailVerified      Boolean                  @default(false)
  phoneVerified      Boolean                  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  barberProfile      Barber?
  bookings           Booking[]                @relation("ClientBookings")
  payments           Payment[]
  profile            Profile?
  refreshTokens      RefreshToken[]
  ownedSalons        Salon[]                  @relation("SalonOwner")
  ownedChains        SalonChain[]
  salonMemberships   SalonMember[]
  subscriptions      Subscription[]
  adminAuditLogs     AdminAuditLog[]          @relation("AdminAuditLogs")
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  couponUsages       CouponUsage[]
  emailVerifications EmailVerificationToken[]
  faceAnalyses       FaceAnalysis[]
  favorites          FavoriteHairstyle[]
  invoices           Invoice[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  recommendations    Recommendation[]
  reviews            Review[]
  preferences        UserPreference?
  sessions           UserSession[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Profile {
  id          String       @id @default(cuid())
  userId      String       @unique
  firstName   String
  lastName    String
  gender      Gender?
  birthDate   DateTime?
  avatarUrl   String?
  countryCode CountryCode?
  countryId   String?
  cityId      String?
  districtId  String?
  address     String?
  bio         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  city        City?        @relation(fields: [cityId], references: [id])
  country     Country?     @relation(fields: [countryId], references: [id])
  district    District?    @relation(fields: [districtId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([cityId])
  @@index([districtId])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  language           String   @default("fr")
  currency           String   @default("XAF")
  timezone           String   @default("Africa/Brazzaville")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  marketingEmails    Boolean  @default(false)
  darkMode           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  deviceName       String?
  deviceType       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("api_keys")
}

model Country {
  id          String       @id @default(cuid())
  code        CountryCode  @unique
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cities      City[]
  profiles    Profile[]
  salons      Salon[]
  salonChains SalonChain[]

  @@index([name])
}

model City {
  id          String       @id @default(cuid())
  countryId   String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  country     Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts   District[]
  profiles    Profile[]
  salons      Salon[]
  salonChains SalonChain[]

  @@index([countryId])
  @@index([name])
}

model District {
  id        String    @id @default(cuid())
  cityId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  profiles  Profile[]
  salons    Salon[]

  @@index([cityId])
  @@index([name])
}

model SalonChain {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  ownerId     String
  countryId   String?
  cityId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salons      Salon[]
  city        City?    @relation(fields: [cityId], references: [id])
  country     Country? @relation(fields: [countryId], references: [id])
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Salon {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  logoUrl       String?
  coverImageUrl String?
  phone         String?
  email         String?
  status        SalonStatus      @default(PENDING)
  ownerId       String
  chainId       String?
  countryId     String?
  cityId        String?
  districtId    String?
  address       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  barbers       Barber[]
  bookings      Booking[]
  chain         SalonChain?      @relation(fields: [chainId], references: [id])
  city          City?            @relation(fields: [cityId], references: [id])
  country       Country?         @relation(fields: [countryId], references: [id])
  district      District?        @relation(fields: [districtId], references: [id])
  owner         User             @relation("SalonOwner", fields: [ownerId], references: [id])
  members       SalonMember[]
  reviews       Review[]
  statistics    SalonStatistic[]

  @@index([ownerId])
  @@index([chainId])
  @@index([status])
}

model SalonMember {
  id        String          @id @default(cuid())
  salonId   String
  userId    String
  role      SalonMemberRole @default(STAFF)
  createdAt DateTime        @default(now())
  salon     Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@index([salonId])
  @@index([userId])
}

model Barber {
  id               String            @id @default(cuid())
  userId           String            @unique
  salonId          String?
  professionalName String?
  biography        String?
  yearsExperience  Int               @default(0)
  isAvailable      Boolean           @default(true)
  averageRating    Float             @default(0)
  totalReviews     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salon            Salon?            @relation(fields: [salonId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio        BarberPortfolio[]
  bookings         Booking[]
  hairstyles       Hairstyle[]
  reviews          Review[]

  @@index([salonId])
}

model BarberPortfolio {
  id          String    @id @default(cuid())
  barberId    String
  title       String
  description String?
  imageUrl    String
  mediaType   MediaType @default(IMAGE)
  createdAt   DateTime  @default(now())
  barber      Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

model SubscriptionPlan {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  type              SubscriptionType
  description       String?
  price             Decimal          @db.Decimal(12, 2)
  currency          Currency         @default(XAF)
  durationDays      Int
  maxBookings       Int?
  maxBarbers        Int?
  maxSalons         Int?
  aiRecommendations Boolean          @default(true)
  isPopular         Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  features          PlanFeature[]
  subscriptions     Subscription[]

  @@index([type])
  @@index([isActive])
}

model PlanFeature {
  id        String           @id @default(cuid())
  planId    String
  key       String
  value     String?
  createdAt DateTime         @default(now())
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

model Subscription {
  id            String                @id @default(cuid())
  userId        String
  planId        String
  status        SubscriptionStatus    @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  autoRenew     Boolean               @default(false)
  lastRenewedAt DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  payments      Payment[]
  plan          SubscriptionPlan      @relation(fields: [planId], references: [id])
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history       SubscriptionHistory[]
  invoices      Invoice[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model SubscriptionHistory {
  id             String              @id @default(cuid())
  subscriptionId String
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus
  reason         String?
  createdAt      DateTime            @default(now())
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Booking {
  id           String        @id @default(cuid())
  clientId     String
  barberId     String?
  salonId      String?
  type         BookingType   @default(CLIENT_VISIT)
  status       BookingStatus @default(PENDING)
  scheduledAt  DateTime
  duration     Int           @default(60)
  price        Decimal?      @db.Decimal(12, 2)
  currency     Currency      @default(XAF)
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barber       Barber?       @relation(fields: [barberId], references: [id])
  client       User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  salon        Salon?        @relation(fields: [salonId], references: [id])
  invoices     Invoice[]

  @@index([clientId])
  @@index([barberId])
  @@index([salonId])
  @@index([status])
  @@index([scheduledAt])
}

model Payment {
  id                    String             @id @default(cuid())
  userId                String
  subscriptionId        String?
  invoiceId             String?
  amount                Int
  currency              Currency           @default(XAF)
  provider              PaymentProvider
  paymentMethod         PaymentMethod
  environment           PaymentEnvironment @default(TEST)
  transactionReference  String             @unique
  providerTransactionId String?            @unique
  providerPaymentId     String?
  providerCustomerId    String?
  providerCheckoutId    String?
  status                PaymentStatus      @default(PENDING)
  providerStatus        String?
  description           String?
  phone                 String?
  country               String?
  failureCode           String?
  failureMessage        String?
  idempotencyKey        String             @unique
  webhookReceivedAt     DateTime?
  webhookProcessedAt    DateTime?
  webhookEventId        String?            @unique
  confirmedAt           DateTime?
  refundedAt            DateTime?
  refundReference       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  invoice               Invoice?           @relation(fields: [invoiceId], references: [id])
  subscription          Subscription?      @relation(fields: [subscriptionId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  events                PaymentEvent[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([status])
  @@index([provider])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([providerTransactionId])
  @@index([transactionReference])
}

model PaymentEvent {
  id                String           @id @default(cuid())
  paymentId         String
  type              PaymentEventType
  provider          PaymentProvider
  providerEventId   String?
  statusBefore      PaymentStatus?
  statusAfter       PaymentStatus?
  amount            Int?
  currency          Currency?
  payload           Json?
  signatureVerified Boolean          @default(false)
  processed         Boolean          @default(false)
  processedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime         @default(now())
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider])
  @@index([type])
  @@index([createdAt])
  @@index([providerEventId])
}

model PaymentWebhook {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  eventType       String
  externalEventId String?         @unique
  transactionId   String?
  payload         Json
  headers         Json?
  signature       String?
  status          WebhookStatus   @default(RECEIVED)
  processedAt     DateTime?
  failedAt        DateTime?
  errorMessage    String?
  attempts        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([provider])
  @@index([eventType])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_webhooks")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  userId         String
  subscriptionId String?
  bookingId      String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("XAF")
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  pdfUrl         String?
  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?
  notes          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payments       Payment[]
  items          InvoiceItem[]
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([bookingId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Hairstyle {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String              @unique
  description           String?
  imageUrl              String?
  thumbnailUrl          String?
  category              HairstyleCategory
  gender                HairstyleGender     @default(UNISEX)
  suitableFaceShapes    FaceShape[]
  suitableHairTextures  HairTexture[]
  suitableHairLengths   HairLength[]
  suitableHairDensities HairDensity[]
  difficulty            HairstyleDifficulty @default(MEDIUM)
  estimatedDuration     Int?
  minPrice              Decimal?            @db.Decimal(10, 2)
  maxPrice              Decimal?            @db.Decimal(10, 2)
  popularityScore       Decimal             @default(0) @db.Decimal(8, 2)
  viewCount             Int                 @default(0)
  recommendationCount   Int                 @default(0)
  isActive              Boolean             @default(true)
  isPremium             Boolean             @default(false)
  aiDescription         String?
  metadata              Json?
  barberId              String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  favorites             FavoriteHairstyle[]
  barber                Barber?             @relation(fields: [barberId], references: [id])
  recommendations       Recommendation[]
  reviews               Review[]

  @@index([category])
  @@index([gender])
  @@index([difficulty])
  @@index([isActive])
  @@index([isPremium])
  @@index([popularityScore])
  @@map("hairstyles")
}

model FaceAnalysis {
  id               String             @id @default(cuid())
  userId           String
  imageUrl         String?
  imageStoragePath String?
  faceDetected     Boolean            @default(false)
  confidenceScore  Decimal?           @db.Decimal(5, 2)
  faceShape        FaceShape?
  foreheadWidth    Decimal?           @db.Decimal(6, 2)
  cheekboneWidth   Decimal?           @db.Decimal(6, 2)
  jawlineWidth     Decimal?           @db.Decimal(6, 2)
  faceLength       Decimal?           @db.Decimal(6, 2)
  skinTone         String?
  hairTexture      HairTexture?
  hairDensity      HairDensity?
  hairLength       HairLength?
  aiProvider       AIProvider?
  aiModel          String?
  rawResult        Json?
  status           FaceAnalysisStatus @default(PENDING)
  errorMessage     String?
  analyzedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]

  @@index([userId])
  @@index([faceShape])
  @@index([status])
  @@index([createdAt])
  @@map("face_analyses")
}

model Recommendation {
  id                 String       @id @default(cuid())
  userId             String
  faceAnalysisId     String
  hairstyleId        String
  compatibilityScore Decimal      @db.Decimal(5, 2)
  faceShapeScore     Decimal?     @db.Decimal(5, 2)
  hairTextureScore   Decimal?     @db.Decimal(5, 2)
  hairLengthScore    Decimal?     @db.Decimal(5, 2)
  hairDensityScore   Decimal?     @db.Decimal(5, 2)
  rank               Int?
  explanation        String?
  strengths          Json?
  considerations     Json?
  aiProvider         AIProvider?
  aiModel            String?
  isFavorite         Boolean      @default(false)
  viewedAt           DateTime?
  clickedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  faceAnalysis       FaceAnalysis @relation(fields: [faceAnalysisId], references: [id], onDelete: Cascade)
  hairstyle          Hairstyle    @relation(fields: [hairstyleId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([faceAnalysisId, hairstyleId])
  @@index([userId])
  @@index([faceAnalysisId])
  @@index([hairstyleId])
  @@index([compatibilityScore])
  @@index([rank])
  @@index([createdAt])
  @@map("recommendations")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String
  type         NotificationType
  channel      NotificationChannel
  title        String
  message      String
  data         Json?
  isRead       Boolean             @default(false)
  readAt       DateTime?
  status       NotificationStatus  @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  scheduledFor DateTime?
  errorMessage String?
  attempts     Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([isRead])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String?
  type        NotificationType
  channel     NotificationChannel
  subject     String?
  content     String
  variables   Json?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([type])
  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  action       AuditAction
  entityType   String
  entityId     String?
  description  String?
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  success      Boolean     @default(true)
  errorMessage String?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([requestId])
  @@index([success])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminAuditLog {
  id          String      @id @default(cuid())
  adminId     String?
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime    @default(now())
  admin       User?       @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Review {
  id          String     @id @default(cuid())
  userId      String
  salonId     String?
  barberId    String?
  hairstyleId String?
  rating      Int
  title       String?
  comment     String?
  isPublished Boolean    @default(true)
  isVerified  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  barber      Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  hairstyle   Hairstyle? @relation(fields: [hairstyleId], references: [id], onDelete: Cascade)
  salon       Salon?     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([salonId])
  @@index([barberId])
  @@index([hairstyleId])
  @@index([rating])
  @@index([isPublished])
  @@map("reviews")
}

model FavoriteHairstyle {
  id          String    @id @default(cuid())
  userId      String
  hairstyleId String
  createdAt   DateTime  @default(now())
  hairstyle   Hairstyle @relation(fields: [hairstyleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hairstyleId])
  @@index([userId])
  @@index([hairstyleId])
  @@map("favorite_hairstyles")
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  description     String?
  discountType    DiscountType
  discountValue   Decimal       @db.Decimal(12, 2)
  minimumAmount   Decimal?      @db.Decimal(12, 2)
  maximumDiscount Decimal?      @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int           @default(0)
  userLimit       Int?
  startsAt        DateTime
  expiresAt       DateTime
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  usages          CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  paymentId      String?
  discountAmount Decimal  @db.Decimal(12, 2)
  usedAt         DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([paymentId])
  @@map("coupon_usages")
}

model SystemSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  isPublic    Boolean     @default(false)
  isEditable  Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type])
  @@index([isPublic])
  @@map("system_settings")
}

model DailyStatistic {
  id                  String   @id @default(cuid())
  date                DateTime @unique
  totalUsers          Int      @default(0)
  newUsers            Int      @default(0)
  activeUsers         Int      @default(0)
  totalBookings       Int      @default(0)
  completedBookings   Int      @default(0)
  cancelledBookings   Int      @default(0)
  totalPayments       Int      @default(0)
  revenue             Decimal  @default(0) @db.Decimal(14, 2)
  subscriptions       Int      @default(0)
  activeSubscriptions Int      @default(0)
  faceAnalyses        Int      @default(0)
  recommendations     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
  @@map("daily_statistics")
}

model SalonStatistic {
  id                String   @id @default(cuid())
  salonId           String
  date              DateTime
  totalBookings     Int      @default(0)
  completedBookings Int      @default(0)
  cancelledBookings Int      @default(0)
  totalCustomers    Int      @default(0)
  newCustomers      Int      @default(0)
  revenue           Decimal  @default(0) @db.Decimal(14, 2)
  averageRating     Decimal  @default(0) @db.Decimal(3, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  salon             Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, date])
  @@index([salonId])
  @@index([date])
  @@map("salon_statistics")
}

model SubscriptionStatistic {
  id                     String   @id @default(cuid())
  date                   DateTime @unique
  totalSubscriptions     Int      @default(0)
  newSubscriptions       Int      @default(0)
  activeSubscriptions    Int      @default(0)
  cancelledSubscriptions Int      @default(0)
  expiredSubscriptions   Int      @default(0)
  revenue                Decimal  @default(0) @db.Decimal(14, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([date])
  @@map("subscription_statistics")
}

